<% layout('partials/layout') -%>
<h1>Add Student</h1>
<form class="form" method="post" action="/students">
  <div class="grid">
    <label>
      <span>Name</span>
      <input type="text" name="name" required />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" required />
    </label>
    <label>
      <span>Course</span>
      <input type="text" name="course" required />
    </label>
    <label>
      <span>Year</span>
      <input type="number" name="year" min="1" max="8" value="1" />
    </label>
    <label>
      <span>GPA</span>
      <input type="number" step="0.01" name="gpa" min="0" max="10" value="0" />
    </label>
  </div>
  <div class="form-actions">
    <a class="btn" href="/students">Cancel</a>
    <button class="btn btn-primary" type="submit">Create</button>
  </div>
</form>
