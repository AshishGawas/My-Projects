<% layout('partials/layout') -%>
<h1>Edit <%= student.name %></h1>
<form class="form" method="post" action="/students/<%= student._id %>?_method=PUT">
  <div class="grid">
    <label>
      <span>Name</span>
      <input type="text" name="name" required value="<%= student.name %>" />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" required value="<%= student.email %>" />
    </label>
    <label>
      <span>Course</span>
      <input type="text" name="course" required value="<%= student.course %>" />
    </label>
    <label>
      <span>Year</span>
      <input type="number" name="year" min="1" max="8" value="<%= student.year %>" />
    </label>
    <label>
      <span>GPA</span>
      <input type="number" step="0.01" name="gpa" min="0" max="10" value="<%= student.gpa %>" />
    </label>
  </div>
  <div class="form-actions">
    <a class="btn" href="/students/<%= student._id %>">Cancel</a>
    <button class="btn btn-primary" type="submit">Save</button>
  </div>
</form>
